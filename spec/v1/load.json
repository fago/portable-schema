{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portable-schema.dev/v1/load",
  "$comment": "The dialect meta-schema plus the profile's limits, in every subschema: `$schema` names the dialect; no `$vocabulary`, `$dynamicRef`, `$dynamicAnchor`.",
  "$dynamicAnchor": "meta",
  "$ref": "https://portable-schema.dev/v1/schema",
  "properties": {
    "$schema": {
      "const": "https://portable-schema.dev/v1/schema"
    }
  },
  "propertyNames": {
    "not": {
      "enum": [
        "$vocabulary",
        "$dynamicRef",
        "$dynamicAnchor"
      ]
    }
  }
}
