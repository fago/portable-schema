{
  "$schema": "https://portable-schema.dev/v1/schema",
  "$id": "drupal:block.block",
  "title": "Block",
  "$ref": "drupal:config_entity",
  "properties": {
    "id": {
      "title": "ID",
      "type": "string",
      "$comment": "Core uses /^(?!\\.)[a-z0-9_.]+$/. Lookahead is outside the portable regex subset, so the converter rewrites it.",
      "pattern": "^[a-z0-9_][a-z0-9_.]*$"
    },
    "theme": {
      "title": "Theme",
      "$ref": "drupal:catalog/themes"
    },
    "region": {
      "title": "Region",
      "type": "string",
      "portable-typeBy": {
        "href": "drupal:catalog/regions/{theme}",
        "source": {
          "theme": "1/theme"
        }
      }
    },
    "weight": {
      "title": "Weight",
      "$ref": "portable:weight"
    },
    "provider": {
      "title": "Provider",
      "type": [
        "string",
        "null"
      ]
    },
    "plugin": {
      "title": "Plugin",
      "$ref": "drupal:catalog/plugins/block"
    },
    "settings": {
      "$ref": "drupal:block_settings",
      "portable-typeBy": {
        "href": "drupal:block.settings.{plugin}",
        "source": {
          "plugin": "1/plugin"
        },
        "fallback": "drupal:block.settings.*"
      }
    },
    "visibility": {
      "title": "Visibility Conditions",
      "type": "object",
      "additionalProperties": {
        "$ref": "drupal:condition.plugin",
        "portable-typeBy": {
          "href": "drupal:condition.plugin.{id}",
          "source": {
            "id": "0/id"
          },
          "fallback": "drupal:condition.plugin.*"
        }
      }
    }
  },
  "required": [
    "id",
    "theme",
    "region",
    "weight",
    "plugin",
    "settings",
    "visibility"
  ],
  "unevaluatedProperties": false
}
