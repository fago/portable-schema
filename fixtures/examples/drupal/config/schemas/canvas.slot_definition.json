{
  "$schema": "https://portable-schema.dev/v1/schema",
  "$id": "drupal:canvas.slot_definition",
  "title": "Slot",
  "type": "object",
  "properties": {
    "title": {
      "title": "Slot title",
      "$ref": "portable:label",
      "minLength": 1
    },
    "description": {
      "title": "Slot description",
      "$ref": "portable:label",
      "minLength": 1
    },
    "examples": {
      "title": "Examples",
      "type": "array",
      "items": {
        "$ref": "portable:text"
      }
    }
  },
  "required": [
    "title"
  ],
  "unevaluatedProperties": false
}
