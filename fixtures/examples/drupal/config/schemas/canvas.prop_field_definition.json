{
  "$schema": "https://portable-schema.dev/v1/schema",
  "$id": "drupal:canvas.prop_field_definition",
  "title": "Prop field definition",
  "type": "object",
  "properties": {
    "required": {
      "title": "Required prop",
      "$ref": "portable:boolean"
    },
    "field_type": {
      "title": "Default field type",
      "$ref": "drupal:catalog/plugins/field_type"
    },
    "cardinality": {
      "title": "Maximum number of values",
      "$ref": "portable:integer"
    },
    "field_storage_settings": {
      "title": "Field storage settings",
      "type": "object"
    },
    "field_instance_settings": {
      "title": "Field settings",
      "type": "object"
    },
    "field_widget": {
      "title": "Default field widget",
      "$ref": "drupal:catalog/plugins/field_widget"
    },
    "default_value": {
      "title": "Default values",
      "type": [
        "array",
        "null"
      ]
    },
    "expression": {
      "title": "Expression",
      "type": "string"
    },
    "derived_schema_metadata": {
      "title": "Derived schema metadata",
      "type": "object"
    }
  },
  "required": [
    "required",
    "field_type",
    "field_widget",
    "default_value",
    "expression"
  ],
  "unevaluatedProperties": false
}
