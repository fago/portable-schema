{
  "$schema": "https://portable-schema.dev/v1/schema",
  "$id": "drupal:config_entity",
  "title": "Config entity",
  "description": "Open base type for all config entities.",
  "type": "object",
  "properties": {
    "uuid": {
      "$ref": "portable:uuid"
    },
    "langcode": {
      "title": "Language code",
      "anyOf": [
        {
          "$ref": "portable:langcode"
        },
        {
          "const": "site_default"
        }
      ]
    },
    "status": {
      "title": "Status",
      "$ref": "portable:boolean"
    },
    "dependencies": {
      "type": "object",
      "properties": {
        "config": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "content": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "module": {
          "type": "array",
          "items": {
            "$ref": "drupal:catalog/modules"
          }
        },
        "theme": {
          "type": "array",
          "items": {
            "$ref": "drupal:catalog/themes"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
