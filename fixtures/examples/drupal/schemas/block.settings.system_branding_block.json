{
  "$schema": "https://portable-schema.dev/v1/schema",
  "$id": "drupal:block.settings.system_branding_block",
  "title": "Branding block",
  "$ref": "drupal:block_settings",
  "properties": {
    "use_site_logo": {
      "title": "Use site logo",
      "$ref": "portable:boolean"
    },
    "use_site_name": {
      "title": "Use site name",
      "$ref": "portable:boolean"
    },
    "use_site_slogan": {
      "title": "Use site slogan",
      "$ref": "portable:boolean"
    }
  },
  "required": [
    "use_site_logo",
    "use_site_name",
    "use_site_slogan"
  ],
  "unevaluatedProperties": false
}
