    "drupal": "Drupal 11.4-dev (11.x at ad3428034a5b), PHP 8.3.6, PCRE2 10.42, egulias/email-validator 4.0.4, symfony/validator v7.4.10",
    "js": "Node.js 24.22.0, V8 13.6.233.17-node.57, Unicode 17.0"
  },
  "columns": {
    "drupal": "PrimitiveType constraint on the DataType: filter_var() FILTER_VALIDATE_INT / FILTER_VALIDATE_FLOAT, or the decimal regex",
    "portable": "portable:integer (I-JSON range), portable:decimal (format decimal, strings only), portable:number",
    "standard": "JSON Schema type integer / number; n/a for decimal, which the registry defines without a grammar"
  },
