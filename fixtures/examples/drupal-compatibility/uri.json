{
  "description": "URIs: Drupal's uri DataType, link field and url form element vs. the pinned format uri.",
  "environment": {
    "drupal": "Drupal 11.4-dev (11.x at ad3428034a5b), PHP 8.3.6, PCRE2 10.42, egulias/email-validator 4.0.4, symfony/validator v7.4.10",
    "js": "Node.js 24.22.0, V8 13.6.233.17-node.57, Unicode 17.0"
  },
  "columns": {
    "drupalUri": "uri DataType (config schema uri, uri and link fields): PrimitiveType constraint, parse_url() with a scheme",
    "drupalLink": "link field item, link_type internal and external, validated as an entity field (LinkType, LinkAccess, LinkExternalProtocols, LinkNotExistingInternal), as user 1",
    "drupalUrlElement": "UrlHelper::isValid($value, TRUE), as the Form API url element calls it after trim()",
    "portable": "format uri as pinned in spec/profile.md: RFC 3986 URI; equals the standard; checked against the JSON-Schema-Test-Suite",
    "uriReference": "format uri-reference: RFC 3986 URI-reference"
  },
