{
  "description": "allowed values: the titles of a catalog's entries, else the values",
  "registry": {
    "test:catalog/plugins": {
      "title": "Block plugins",
      "oneOf": [
        {
          "const": "branding",
          "title": "Site branding"
        },
        {
          "const": "powered_by",
          "title": "Powered by"
        }
      ]
    }
  },
  "schema": {
    "$schema": "https://portable-schema.dev/v1/schema",
    "type": "object",
    "properties": {
      "plugin": {
        "title": "Plugin",
        "$ref": "test:catalog/plugins"
      },
      "display": {
        "title": "Display",
        "enum": [
          "0",
          "visible"
        ]
      }
    }
  }
}
