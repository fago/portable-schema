{
  "description": "type object and type array are decided by the value: an array is never an object",
  "schema": {
    "$schema": "https://portable-schema.dev/v1/schema",
    "type": "object",
    "properties": {
      "o": {
        "type": "object"
      },
      "a": {
        "type": "array"
      },
      "n": {
        "not": {
          "type": "array"
        }
      },
      "c": {
        "if": {
          "type": "array"
        },
        "then": {
          "minItems": 1
        },
        "else": {
          "required": [
            "k"
          ]
        }
      },
      "x": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "k"
            ]
          },
          {
            "type": "array",
            "minItems": 1
          }
        ]
      }
    }
  }
}
