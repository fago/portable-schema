{
  "description": "string lengths count code points, not UTF-16 units or bytes",
  "schema": {
    "$schema": "https://portable-schema.dev/v1/schema",
    "type": "object",
    "properties": {
      "short": {
        "type": "string",
        "maxLength": 1
      },
      "long": {
        "type": "string",
        "minLength": 2
      }
    }
  }
}
