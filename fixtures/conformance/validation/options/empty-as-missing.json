{
  "description": "emptyAsMissing: with partial, empty values count as missing",
  "schema": {
    "$schema": "https://portable-schema.dev/v1/schema",
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1
      },
      "age": {
        "$ref": "portable:integer"
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "required": [
      "name",
      "age"
    ]
  }
}
